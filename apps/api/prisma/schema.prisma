// ─────────────────────────────────────────────────────────────
// Naqla Logistics — Prisma Schema
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CLIENT_ADMIN
  CLIENT_USER
  CARRIER_ADMIN
  CARRIER_USER
  DRIVER
}

enum CompanyType {
  CLIENT
  CARRIER
}

enum CompanyEntityType {
  COMPANY
  INDIVIDUAL
}

/// Per-company role of a user inside their company account. Controls which
/// company features they can access. Different from UserRole (which is the
/// platform-wide kind: admin / client_admin / carrier_admin / driver).
enum CompanyRole {
  OWNER // single per company; created at signup
  ADMIN // full access except cannot remove the owner
  STAFF // (client side) operations: create/track orders
  DISPATCH // (carrier side) accept orders, manage fleet
  FINANCE // read-only on invoices/payments + export
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PUBLISHED
  BIDDING
  ASSIGNED
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TruckType {
  // The carrier add-truck UI uses the catalog in
  // packages/shared-utils/src/mock-data.ts → DEFAULT_TRUCK_TYPES.
  // Keep this enum a superset of those IDs so the form can submit any value
  // the carrier selects without a manual mapping.
  SMALL_VAN
  SMALL_FLATBED
  MEDIUM_FLATBED
  LARGE_FLATBED
  REFRIGERATED
  CONTAINER_20
  CONTAINER_40
  CONTAINER_TRAILER
  TANKER
  CURTAINSIDER
  BOX_TRUCK
  LOWBED
}

enum CargoType {
  GENERAL
  FOOD
  CHEMICALS
  ELECTRONICS
  FURNITURE
  CONSTRUCTION
  AUTOMOTIVE
  MEDICAL
  HAZARDOUS
  FRAGILE
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  ORDER_CREATED
  BID_RECEIVED
  BID_ACCEPTED
  BID_REJECTED
  ORDER_ASSIGNED
  ORDER_CONFIRMED
  SHIPMENT_STARTED
  SHIPMENT_DELIVERED
  PAYMENT_RECEIVED
  PAYMENT_RELEASED
  KYC_APPROVED
  KYC_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  SYSTEM
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  TECHNICAL
  BILLING
  ACCOUNT
  ORDER
  GENERAL
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum TruckStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OFF_DUTY
}

enum FreelancerInvoiceStatus {
  DUE
  PAID
}

/// Whether a truck/driver is part of the provider's OWN fleet or a FREELANCER
/// contracted and paid per delivery. Freelancer trips are billed via
/// per-trip invoices (see provider profitability).
enum FleetOwnership {
  OWNED
  FREELANCER
}

// ─── MODELS ───────────────────────────────────────────────────────

model User {
  id                String      @id @default(cuid())
  email             String?     @unique
  phone             String      @unique
  passwordHash      String?
  role              UserRole
  firstName         String
  lastName          String
  avatar            String?
  isActive          Boolean     @default(true)
  isEmailVerified   Boolean     @default(false)
  isPhoneVerified   Boolean     @default(false)
  /// Preferred UI language — 'ar' or 'en'. Used to render every interface on sign-in.
  preferredLanguage String      @default("ar")
  nationalId        String?
  /// Per-company role inside the user's company account.
  /// Only meaningful for users that belong to a company (CLIENT/CARRIER).
  companyRole       CompanyRole @default(STAFF)
  lastLoginAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  driverProfile DriverProfile?
  notifications Notification[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]

  @@index([companyId])
  @@index([role])
}

model Company {
  id              String            @id @default(cuid())
  /// Short, human-friendly public reference (e.g. "NQ-7K4F2P") shown in the UI
  /// instead of the internal cuid. Generated at creation; unique.
  code            String?           @unique
  type            CompanyType
  /// COMPANY (a registered business) or INDIVIDUAL (a sole operator — a single
  /// freelance driver who is also their own carrier, or an individual client).
  entityType      CompanyEntityType @default(COMPANY)
  status          CompanyStatus     @default(PENDING_VERIFICATION)
  kycStatus       KYCStatus         @default(NOT_SUBMITTED)
  /// Company-default UI language for transactional emails/SMS templates and
  /// new team members. Individual users can still override via `User.preferredLanguage`.
  defaultLanguage String            @default("ar")

  nameAr    String
  nameEn    String?
  crNumber  String? @unique
  vatNumber String?
  logo      String?

  city    String
  region  String
  address String?

  contactPhone String
  contactEmail String
  website      String?

  commissionRate Decimal @default(0.08) @db.Decimal(5, 4)
  creditLimit    Decimal @default(0) @db.Decimal(12, 2)
  walletBalance  Decimal @default(0) @db.Decimal(12, 2)

  subscriptionPlan   String    @default("basic")
  subscriptionEndsAt DateTime?

  /// White-label: when enabled (by an admin), a carrier's own client area and
  /// driver app render under the carrier's brand instead of Naqla's.
  whiteLabelEnabled Boolean @default(false)
  brandName         String?
  brandLogo         String?
  /// Primary brand color as a hex string (e.g. "#0F766E").
  brandColor        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  trucks  Truck[]
  drivers DriverProfile[]

  ordersAsClient         Order[] @relation("ClientOrders")
  ordersAsCarrier        Order[] @relation("CarrierOrders")
  ordersDirectlyTargeted Order[] @relation("TargetCarrierOrders")
  carrierLegs            OrderLeg[] @relation("CarrierLegs")

  /// Sub-tenancy: when a CLIENT company was registered by a carrier, this is
  /// that owning carrier. Owned clients' orders route privately to the owner
  /// and never appear on the open market or to other carriers.
  ownerCarrierId String?
  ownerCarrier   Company?  @relation("OwnedClients", fields: [ownerCarrierId], references: [id])
  ownedClients   Company[] @relation("OwnedClients")

  /// The Plan (membership) this company subscribes to; resolves its operating
  /// policy via the plan's Policy Profile. Null → legacy group membership / default.
  planId String?
  plan   Plan?  @relation(fields: [planId], references: [id])

  bids               Bid[]
  invoicesIssued     Invoice[]           @relation("IssuerInvoices")
  invoicesReceived   Invoice[]           @relation("ReceiverInvoices")
  kycDocuments       KYCDocument[]
  transactions       Transaction[]
  reviews            Review[]            @relation("ReviewedCompany")
  reviewsGiven       Review[]            @relation("ReviewerCompany")
  supportTickets     SupportTicket[]
  savedAddresses     SavedAddress[]
  freelancerInvoices FreelancerInvoice[] @relation("CarrierFreelancerInvoices")

  @@index([type, status])
  @@index([city])
}

model KYCDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  type       String
  fileUrl    String
  status     KYCStatus @default(PENDING)
  notes      String?
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Truck {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  plateNumber String    @unique
  type        TruckType
  capacity    Float
  length      Float?
  width       Float?
  height      Float?

  make  String?
  model String?
  year  Int?

  hasRefrigeration Boolean @default(false)
  hasGPS           Boolean @default(false)
  isActive         Boolean @default(true)

  ownership FleetOwnership @default(OWNED)
  status    TruckStatus    @default(AVAILABLE)

  photos    String[]
  documents String[]

  currentDriverId String?
  currentDriver   DriverProfile? @relation(fields: [currentDriverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderTrucks OrderTruck[]

  @@index([companyId])
  @@index([type])
}

model DriverProfile {
  id        String  @id @default(cuid())
  /// Short, human-friendly public reference (e.g. "DR-7K4F2P") shown in the UI
  /// instead of the raw cuid.
  code      String? @unique
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  licenseNumber String   @unique
  licenseExpiry DateTime
  licenseType   String

  status         DriverStatus   @default(OFF_DUTY)
  ownership      FleetOwnership @default(OWNED)
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?

  rating     Float @default(0)
  totalTrips Int   @default(0)

  photo    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTrucks  Truck[]
  orderDrivers    OrderDriver[]
  locationHistory LocationHistory[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @default(cuid())
  status      OrderStatus @default(DRAFT)

  /// "OPEN" → all carriers can bid; "DIRECT" → only targetCarrier sees it.
  /// String (not enum) so we can add modes without a migration; validated at the DTO.
  mode            String   @default("OPEN")
  targetCarrierId String?
  targetCarrier   Company? @relation("TargetCarrierOrders", fields: [targetCarrierId], references: [id])

  /// "SAME_CITY" | "INTER_CITY" — drives Wizard UI + distance/route assumptions.
  tripType     String @default("INTER_CITY")
  /// "MORNING" (8-12) | "EVENING" (12-18) | "ALL_DAY" (8-18) — client's preferred pickup band.
  pickupWindow String @default("ALL_DAY")

  /// How the client pays — chosen at creation, gated by the client's policy.
  /// "ESCROW" (default; platform holds until completion) | "PREPAID_WALLET"
  /// (debited from the client wallet now) | "PREPAID_GATEWAY" (charged online
  /// now, stubbed provider) | "COD" (collected on delivery).
  collectionMethod String @default("ESCROW")

  /// "SINGLE" | "CONSOLIDATED" — a consolidated order ships `truckCount` trucks
  /// along the same route; its legs are OrderTruck rows (String, no migration to
  /// add a type). truckCount is null for single orders.
  orderType     String   @default("SINGLE")
  truckCount    Int?
  /// Per-leg shipment reference numbers for a consolidated order, ordered by
  /// leg sequence (index 1..truckCount → legReferences[0..truckCount-1]). Set
  /// by the client at creation, or auto-generated as `<orderNumber>-L<n>`.
  legReferences String[] @default([])

  clientId  String
  client    Company  @relation("ClientOrders", fields: [clientId], references: [id])
  carrierId String?
  carrier   Company? @relation("CarrierOrders", fields: [carrierId], references: [id])

  cargoType        CargoType
  cargoDescription String
  weight           Float
  pallets          Int?
  volume           Float?

  originCity    String
  originRegion  String
  originAddress String
  originLat     Float?
  originLng     Float?

  destinationCity    String
  destinationRegion  String
  destinationAddress String
  destinationLat     Float?
  destinationLng     Float?

  requiredTruckType     TruckType
  requiresRefrigeration Boolean   @default(false)
  requiresInsurance     Boolean   @default(false)
  specialInstructions   String?

  pickupDate   DateTime
  deliveryDate DateTime?
  bidDeadline  DateTime?

  clientBudget     Decimal? @db.Decimal(12, 2)
  agreedPrice      Decimal? @db.Decimal(12, 2)
  commissionAmount Decimal? @db.Decimal(12, 2)
  carrierAmount    Decimal? @db.Decimal(12, 2)

  actualPickupAt   DateTime?
  actualDeliveryAt DateTime?

  poNumber  String?
  bolNumber String?
  documents String[]

  clientRating  Int?
  carrierRating Int?

  notes        String?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids           Bid[]
  orderTrucks    OrderTruck[]
  orderLegs      OrderLeg[]
  orderDrivers   OrderDriver[]
  stops          OrderStop[]
  trackingEvents TrackingEvent[]
  payment        Payment?
  invoice        Invoice?
  dispute        Dispute?
  review         Review?

  @@index([clientId, status])
  @@index([carrierId, status])
  @@index([status])
  @@index([pickupDate])
  @@index([originCity, destinationCity])
}

/// A single stop on an order's route. The route is an ordered list of stops;
/// a legacy single origin→destination order is a 2-stop route (PICKUP at the
/// origin, DELIVERY at the destination), synthesized on read for old rows and
/// persisted for new ones. A CONSOLIDATED order's trucks all share this one
/// route ("same trip"). Backwards-compatible: Order keeps its origin and
/// destination columns as a denormalized summary (first PICKUP / last delivery).
model OrderStop {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 1-based position in the route.
  sequence Int
  type     StopType
  /// "PENDING" | "EN_ROUTE" | "ARRIVED" | "COMPLETED" | "SKIPPED".
  /// String (not enum) to mirror OrderTruck.status and add states migration-free.
  status   String   @default("PENDING")

  city    String
  region  String
  address String
  lat     Float?
  lng     Float?

  contactName  String?
  contactPhone String?
  scheduledAt  DateTime?
  windowStart  DateTime?
  windowEnd    DateTime?
  instructions String?

  /// Container handling at this stop (for CONTAINER_* trucks / empty return).
  containerNo   String?
  /// True when this stop is the empty-container return that keeps the trip
  /// open after the cargo is delivered (cargo-delivery vs trip-completion).
  isEmptyReturn Boolean @default(false)

  arrivedAt   DateTime?
  completedAt DateTime?
  proofPhotos String[]  @default([])
  proofNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, sequence])
  @@index([orderId])
}

enum StopType {
  PICKUP
  DELIVERY
  DROPOFF
  WAREHOUSE
  RETURN_EMPTY
  EXCHANGE
}

model Bid {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  carrierId String
  carrier   Company @relation(fields: [carrierId], references: [id])

  /// Phase 2b — a bid may target a specific LEG of a heterogeneous order
  /// (per-leg marketplace). Null = a classic order-level bid.
  orderLegId String?
  orderLeg   OrderLeg? @relation(fields: [orderLegId], references: [id], onDelete: Cascade)

  amount Decimal   @db.Decimal(12, 2)
  status BidStatus @default(PENDING)

  /// Legacy ETA fields — kept on the model for back-compat with any older
  /// bids but no longer collected via the carrier form (v0.8.x replaced
  /// them with an explicit `proposedDeliveryDate` date picker).
  estimatedDays        Int       @default(0)
  estimatedHours       Int?
  /// If the carrier wants a different pickup date than what the client
  /// requested, they set this. Empty = bid agrees with `order.pickupDate`.
  proposedPickupDate   DateTime?
  /// Carrier's concrete proposed delivery date. Replaces the older
  /// days/hours duration fields. If null, falls back to `order.deliveryDate`
  /// when displaying "expected delivery" on the order detail page.
  proposedDeliveryDate DateTime?
  notes                String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Uniqueness is enforced by two PARTIAL unique indexes created in the
  // migration (order-level: one bid per (order, carrier); leg-level: one bid per
  // (leg, carrier)), since a carrier may bid on several legs of one order.
  @@index([orderId, carrierId])
  @@index([orderLegId, status])
  @@index([orderId, status])
}

/// A leg of an order. For a CONSOLIDATED order there is one row per DISTRIBUTED
/// leg (undistributed legs have no row; truckCount is the total). `sequence` is
/// the 1-based leg index; `status` tracks the leg lifecycle
/// ("ASSIGNED" | "IN_TRANSIT" | "DELIVERED") as a String (no migration to add a
/// status). `driverId` is the leg's driver (resolved against the fleet).
model OrderTruck {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  truckId String
  truck   Truck  @relation(fields: [truckId], references: [id])

  driverId String?
  sequence Int     @default(0)
  status   String  @default("ASSIGNED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, truckId])
  @@unique([orderId, sequence])
}

model OrderDriver {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id])
  driverId String
  driver   DriverProfile @relation(fields: [driverId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([orderId, driverId])
}

/// The per-leg SPEC of a CONSOLIDATED order — what makes its legs heterogeneous.
/// Each leg can carry a different truck type, a different destination, its own
/// price, and (phase 2) its own CARRIER, all sharing the order's single pickup
/// origin, client and invoice. One row per leg (sequence 1..truckCount), created
/// at order creation. The truck/driver assignment stays on `OrderTruck` (same
/// `(orderId, sequence)`). Homogeneous legacy orders have no rows and fall back
/// to the order's own truck type / destination / price / carrier.
model OrderLeg {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 1-based leg index, aligned with OrderTruck.sequence and legReferences[idx-1].
  sequence Int

  reference         String?
  requiredTruckType TruckType

  /// Per-leg destination (origin is shared with the order's pickup).
  destinationCity    String
  destinationRegion  String
  destinationAddress String
  destinationLat     Float?
  destinationLng     Float?

  /// Per-leg price; the order total is the sum of its legs' prices.
  price Decimal? @db.Decimal(12, 2)

  /// Phase 2 — a leg can be served by its own carrier. When set, the leg's
  /// lifecycle and payout are tracked here (independent of the order's carrier).
  carrierId        String?
  carrier          Company? @relation("CarrierLegs", fields: [carrierId], references: [id])
  /// Leg lifecycle: "PENDING" | "ASSIGNED" | "IN_TRANSIT" | "DELIVERED".
  /// Authoritative for heterogeneous orders; homogeneous orders use OrderTruck.
  status           String   @default("PENDING")
  /// Per-leg financial split (of `price`) when a carrier is assigned.
  commissionAmount Decimal? @db.Decimal(12, 2)
  carrierAmount    Decimal? @db.Decimal(12, 2)
  /// When the leg's carrier payout was released (on leg delivery).
  settledAt        DateTime?

  /// Per-leg bids (phase 2b) when the leg is on the open market.
  bids Bid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, sequence])
  @@index([orderId])
  @@index([carrierId])
}

model TrackingEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  status      String
  description String

  lat  Float?
  lng  Float?
  city String?

  photos    String[]
  signature String?
  notes     String?

  createdBy String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model LocationHistory {
  id       String        @id @default(cuid())
  driverId String
  driver   DriverProfile @relation(fields: [driverId], references: [id])

  lat   Float
  lng   Float
  speed Float?

  recordedAt DateTime @default(now())

  @@index([driverId, recordedAt])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  status           PaymentStatus @default(PENDING)
  totalAmount      Decimal       @db.Decimal(12, 2)
  commissionAmount Decimal       @db.Decimal(12, 2)
  carrierAmount    Decimal       @db.Decimal(12, 2)

  paymentMethod  String?
  transactionRef String?

  /// Mirrors Order.collectionMethod for this payment's settlement strategy.
  collectionMethod String  @default("ESCROW")
  /// Amount still to be collected on delivery (COD / partial remainder); 0 for
  /// fully-prepaid or escrow payments.
  dueOnDelivery    Decimal @default(0) @db.Decimal(12, 2)

  paidAt      DateTime?
  heldAt      DateTime?
  releasedAt  DateTime?
  /// When the on-delivery amount (COD) was recorded as collected.
  collectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  type    String
  amount  Decimal @db.Decimal(12, 2)
  balance Decimal @db.Decimal(12, 2)

  reference   String?
  description String

  orderId   String?
  invoiceId String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @default(cuid())
  status        InvoiceStatus @default(DRAFT)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  issuerId   String
  issuer     Company @relation("IssuerInvoices", fields: [issuerId], references: [id])
  receiverId String
  receiver   Company @relation("ReceiverInvoices", fields: [receiverId], references: [id])

  amount      Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  vatNumber String?
  crNumber  String?

  notes  String?
  pdfUrl String?

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-trip fee a provider (carrier) owes a FREELANCER truck/driver. Issued
/// when an order (or a consolidated leg) is assigned to a freelancer.
/// `orderId` is the order number or a synthetic leg id, not an Order FK, so it
/// also covers consolidated legs that are not standalone Order rows.
/// `orderRevenue` snapshots what the carrier earns from the client so provider
/// profit = orderRevenue - amount without re-resolving the order later.
model FreelancerInvoice {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Company @relation("CarrierFreelancerInvoices", fields: [carrierId], references: [id])

  orderId     String
  orderNumber String
  truckId     String
  driverId    String?

  amount       Decimal                 @db.Decimal(12, 2)
  orderRevenue Decimal?                @db.Decimal(12, 2)
  status       FreelancerInvoiceStatus @default(DUE)

  issuedAt  DateTime  @default(now())
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([carrierId, orderId, truckId])
  @@index([carrierId, status])
}

model Dispute {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  status      DisputeStatus @default(OPEN)
  reason      String
  description String

  openedBy   String
  assignedTo String?

  resolution String?
  resolvedAt DateTime?

  attachments String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  reviewerId String
  reviewer   Company @relation("ReviewerCompany", fields: [reviewerId], references: [id])
  reviewedId String
  reviewed   Company @relation("ReviewedCompany", fields: [reviewedId], references: [id])

  rating  Int
  comment String?

  onTime         Boolean?
  cargoCondition Boolean?
  communication  Boolean?

  createdAt DateTime @default(now())

  @@index([reviewedId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  titleAr String
  titleEn String?
  bodyAr  String
  bodyEn  String?

  isRead Boolean   @default(false)
  readAt DateTime?

  data Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action       String
  resourceType String
  resourceId   String?

  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  token     String    @unique
  isRevoked Boolean   @default(false)
  revokedAt DateTime?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name       String
  key        String    @unique
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

/// Admin per-client / per-group platform policy. A client company belongs to at
/// most one group (via `clientIds`); clients in no group use the defaults
/// (everything enabled). `forcedCarrierId` locks direct-assign to one carrier.
model PolicyGroup {
  id          String  @id @default(cuid())
  name        String
  description String?

  allowMarket        Boolean @default(true)
  allowDirect        Boolean @default(true)
  forcedCarrierId    String?
  allowMarketPricing Boolean @default(true)
  allowFixedPricing  Boolean @default(true)
  allowPrepaid       Boolean @default(true)
  allowCOD           Boolean @default(true)

  /// ─── Per-group module defaults (set by the admin, not the client) ───
  /// The group's default sourcing module: "MARKET" (open) | "DIRECT" | null
  /// (no default → open market). Applied when the client doesn't choose.
  defaultAssignment String?
  /// The group's default pricing module: "MARKET" (bids) | "FIXED" | null.
  defaultPricing String?
  /// The group's default collection (payment) method — one of the
  /// CollectionMethod values. Null → ESCROW fallback.
  defaultCollectionMethod String?
  /// When true, the collection method is fixed by the admin: the client cannot
  /// override it and `defaultCollectionMethod` is enforced on every order.
  enforceCollectionMethod Boolean @default(false)

  /// Which providers this group's clients can see/deal with:
  /// "ALL" (whole marketplace) | "GROUP" (only `visibleCarrierGroupId`'s carriers)
  /// | "CARRIER" (only `forcedCarrierId`). Default ALL = today's open market.
  visibilityScope       String  @default("ALL")
  visibleCarrierGroupId String?

  /// ─── Capability layer (Workflow & Policy Engine) ───
  /// Feature flags + numeric limits as a flexible map, e.g.
  /// `{ consolidatedOrders: true, perLegCarriers: true, whiteLabel: false,
  ///    freelancerFleet: true, liveTracking: true, maxActiveOrders: 50 }`.
  /// A feature is DENIED only when explicitly false; absent = allowed (so an
  /// ungrouped company keeps today's full access). Extensible without migrations.
  features Json?

  /// ─── Commission config (consumed by the finance/tax module — phase 2) ───
  /// Platform commission rate for this profile (e.g. 0.08). Null → platform default.
  commissionRate      Decimal? @db.Decimal(5, 4)
  /// Who bears the commission: "CLIENT" | "CARRIER" | "BOTH" (default CARRIER).
  commissionAppliesTo String?
  /// Whether an order's agreed price is VAT-inclusive (else VAT is added on top).
  priceVatInclusive   Boolean  @default(false)

  /// Client company ids governed by this group (legacy direct membership; a Plan
  /// is the preferred binding — see the Plan model).
  clientIds String[]

  plans Plan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A commercial PLAN / membership (باقة/عضوية). A thin wrapper a company
/// subscribes to; its *shape* comes from the Policy Profile (PolicyGroup) it
/// references. Audience-aware so client plans and carrier plans differ.
model Plan {
  id          String  @id @default(cuid())
  name        String
  nameEn      String?
  description String?
  /// "BASIC" | "PRO" | "ENTERPRISE" | … — a free label for the tier.
  tier        String?
  /// Who this plan is for: "CLIENT" | "CARRIER" | "BOTH".
  audience    String  @default("BOTH")
  /// The default plan assigned to new companies of this audience when none chosen.
  isDefault   Boolean @default(false)
  active      Boolean @default(true)

  /// The operating ruleset this plan grants.
  policyGroupId String
  policyGroup   PolicyGroup @relation(fields: [policyGroupId], references: [id])

  /// Optional commission override on top of the profile's commission (commercial lever).
  commissionRateOverride Decimal? @db.Decimal(5, 4)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, active])
}

/// A named set of provider (carrier) companies, used to scope which providers a
/// client group can see (PolicyGroup.visibilityScope = "GROUP").
model CarrierGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Carrier company ids in this group.
  carrierIds  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id          String                @id @default(cuid())
  subject     String
  category    SupportTicketCategory
  description String
  status      SupportTicketStatus   @default(OPEN)

  // The user who opened the ticket. Company optional — staff users have a
  // company, but internal admins may open tickets without one.
  openedBy  String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  attachments String[]
  // Plain text response from support; richer thread later if needed.
  resolution  String?
  resolvedAt  DateTime?
  assignedTo  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

enum AddressKind {
  PICKUP
  DESTINATION
  BOTH
}

model SavedAddress {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label        String
  city         String
  region       String?
  address      String
  contactName  String?
  contactPhone String?
  kind         AddressKind @default(BOTH)
  isDefault    Boolean     @default(false)
  lat          Float?
  lng          Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
}
