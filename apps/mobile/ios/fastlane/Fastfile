# NQLAH iOS → TestFlight, built on a cloud macOS runner (no local Xcode).
# Signing is headless via fastlane `match`: the distribution certificate + its
# private key + the App Store profile are stored ENCRYPTED (MATCH_PASSWORD) in
# the repo's `ios-signing` branch and reused on every run. This fixes the old
# per-build `cert` approach, which created a new Apple Distribution certificate
# each run and hit Apple's 2-certificate cap. The App Store Connect API key is
# still used (cert/profile management + upload); no Keychain export, no Xcode.

default_platform(:ios)

APP_ID = "sa.nx.nqlah.nqlahMobile"
# match git storage — same repo, dedicated branch. CI authenticates with the
# Actions GITHUB_TOKEN via MATCH_GIT_BASIC_AUTHORIZATION (set in the workflow),
# so no extra git credentials are needed.
MATCH_GIT_URL = "https://github.com/wa1eeed/nqlah-logistic.git"
MATCH_GIT_BRANCH = "ios-signing"

platform :ios do
  desc "Build the Flutter app and upload it to TestFlight"
  lane :beta do
    # Creates a throwaway keychain on CI (so the new cert has somewhere to live).
    setup_ci

    # pubspec path relative to THIS Fastfile (apps/mobile/ios/fastlane/), so it
    # is correct regardless of fastlane's working directory.
    pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),      # raw .p8 contents
      is_key_content_base64: false,
      in_house: false,
    )

    # Distribution cert + App Store profile via match. readonly:false so the
    # FIRST run bootstraps (creates the cert+profile and stores them encrypted
    # in the ios-signing branch); later runs find them in storage and just
    # install — no new certificate is ever created. match imports into the
    # throwaway keychain setup_ci made (empty password).
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: APP_ID,
      storage_mode: "git",
      git_url: MATCH_GIT_URL,
      git_branch: MATCH_GIT_BRANCH,
      readonly: false,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
    )
    profile_name = "match AppStore #{APP_ID}"

    # Point the Runner target at the manual distribution identity + profile.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    # Next build number above whatever is already on TestFlight (so re-runs
    # never collide). Starts at 1 for the very first upload.
    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0,
    ) + 1
    increment_build_number(build_number: next_build, xcodeproj: "Runner.xcodeproj")

    # Archive + export the signed IPA. The Flutter artifacts + Pods are produced
    # by the `flutter build ios --no-codesign` step in the workflow beforehand.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios-ipa",
      export_options: {
        provisioningProfiles: { APP_ID => profile_name },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )

    # Tell the admin dashboard which build just shipped, so Settings →
    # "إعدادات التطبيق" shows the current TestFlight version automatically.
    report_version_to_dashboard(channel: "iosTestFlight", build: next_build, pubspec_path: pubspec_path)
  end
end

# Posts the shipped version/build to the NQLAH admin dashboard via the deploy
# hook (PUT /settings/app/versions, APP_VERSION_DEPLOY_TOKEN). Marketing version
# is read from pubspec. No-op (just a log line) when the dashboard env vars
# aren't set, and never fails the lane — the upload already succeeded here.
def report_version_to_dashboard(channel:, build:, pubspec_path:)
  base  = ENV["APP_VERSION_API_BASE"].to_s   # e.g. https://api.nqlah.nx.sa/api
  token = ENV["APP_VERSION_DEPLOY_TOKEN"].to_s
  if base.empty? || token.empty?
    UI.important("Skipping dashboard version report — set APP_VERSION_API_BASE and APP_VERSION_DEPLOY_TOKEN to enable it.")
    return
  end
  version = File.read(pubspec_path)[/^version:\s*([^\s+]+)/, 1] || "0.0.0"
  label   = "#{version} (#{build})"
  require "json"
  # Payload goes through the shell env (not string-interpolated) and logging is
  # off, so the deploy token never lands in the CI log.
  ENV["NQ_VERSION_PAYLOAD"] = { channel => label }.to_json
  sh(
    'curl -fsS -X PUT "$APP_VERSION_API_BASE/settings/app/versions" ' \
    '-H "Content-Type: application/json" ' \
    '-H "x-deploy-token: $APP_VERSION_DEPLOY_TOKEN" ' \
    '-d "$NQ_VERSION_PAYLOAD"',
    log: false,
  )
  UI.success("Reported #{channel} = #{label} to the admin dashboard.")
rescue => e
  UI.important("Dashboard version report failed (non-fatal): #{e.message}")
end
